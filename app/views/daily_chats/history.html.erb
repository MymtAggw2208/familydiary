<% content_for :title, "チャット履歴" %>

<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <div class="h1">チャット履歴</div>
  </div>
  
  <% if @daily_chats.any? %>
    <div class="countainer m-3">
      <% @daily_chats.each do |daily_chat| %>
        <div class="card m-4 shadow rounded">
          <div class="card-title text-bg-primary">
            <div class="h3"><%= daily_chat.title %></div>
          </div>
          <div class="card-subtitle ps-4 text-secondary">
            <%= l daily_chat.chat_date, format: :long %>
          </div>
          <div class="card-body m-2">          
            <% if daily_chat.last_message %>
              <p class="m-1">
                <%= daily_chat.last_message.user_message? ? "あなた" : "AIアシスタント" %>:
              </p>
              <p class="truncate m-2">
                <%= truncate(daily_chat.last_message.content, length: 100) %>
              </p>
            <% end %>
          </div>
          <div class="card-footer d-flex">
            <% if daily_chat.chat_date == Date.current %>
              <%= button_to "開く", today_daily_chats_path, method: :get , class: "btn btn-primary ms-3" %>
            <% else %>
              <%= button_to "開く", date_daily_chats_path(daily_chat.chat_date.strftime('%Y-%m-%d')),
                method: :get, class: "btn btn-primary ms-3" %>
            <% end %>
            <span class="bg-blue-100 text-blue-800 text-sm px-2 py-1 rounded">
              <%= daily_chat.chat_messages.count %>件
            </span>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="countainer text-center m-3">
      <div class="th3">まだチャット履歴がありません</div>
      <p class="text-secondary">今日からAIとの対話を始めましょう</p>
      <%= button_to "今日のチャットを始める", today_daily_chats_path, method: :get,
          class: "btn btn-primary" %>
    </div>
  <% end %>
</div>