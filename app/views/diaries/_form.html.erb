<%= form_with(model: diary) do |f| %>
  <% if diary.errors.any? %>
    <div class="alert alert-danger">
      <h5><%= diary.errors.count %> 件のエラーにより保存できませんでした:</h5>

      <ul>
        <% diary.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-4">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-control" %>
  </div>

  <div class="my-4">
    <%= f.label :description, class: "form-label" %>
    <%= f.textarea :description, placeholder: "日記を入力してください...", class: "form-control" %>
  </div>

  <div class="my-4">
    <%= f.label :picture, class: "form-label" %>
    <%= f.file_field :picture, class: "form-control" %>
  </div>

  <div class="my-4">
    <%= f.label :published_at, class: "form-label" %>
    <%= f.date_field :published_at, class: "form-control" %>
  </div>

  <div class="my-4">
    <%= f.label :visible, class: "form-label" %>
    <div class="form-check form-switch">
      <%= f.check_box :visible, class: "form-check-input" %>
      <label class="form-check-label" for="diary_visible">公開する</label>
    </div>

  <div class="my-4">
    <%= f.submit class: "btn btn-primary" %>
  </div>
<% end %>
